#include <vector>
#include <algorithm>  // for std::max

// Raw peak in one frame
struct Peak {
    float frequency;
    float amplitude;
    int harmonicNo;    // 0 = not a harmonic, 1 = first, 2 = second, …
};

// Time‐indexed sample for one harmonic
struct TrackData {
    size_t index;      // frame/time index
    float frequency;
    float amplitude;
};

// Build tracks: one vector<TrackData> per harmonicNo (1…maxHarmonic)
std::vector<std::vector<TrackData>> generateTracks(
    const std::vector<std::vector<Peak>>& allPeaks)
{
    // 1. Find highest harmonic number
    int maxHarmonic = 0;
    for (const auto& frame : allPeaks) {
        for (const auto& p : frame) {
            if (p.harmonicNo > maxHarmonic) {
                maxHarmonic = p.harmonicNo;
            }
        }
    }

    // 2. Prepare one track per harmonic > 0; ignore index 0
    std::vector<std::vector<TrackData>> tracks(maxHarmonic + 1);

    // 3. Fill tracks
    for (size_t i = 0; i < allPeaks.size(); ++i) {
        for (const auto& p : allPeaks[i]) {
            if (p.harmonicNo > 0) {
                tracks[p.harmonicNo].push_back(
                    TrackData{ i, p.frequency, p.amplitude }
                );
            }
        }
    }

    // Optionally remove the empty 0th bucket
    tracks.erase(tracks.begin());
    return tracks;  // tracks[0] = first harmonic, tracks[1] = second, etc.
}

// Example usage
int main() {
    std::vector<std::vector<Peak>> allPeaks = /* … load or compute … */;
    auto tracks = generateTracks(allPeaks);

    // tracks[0] holds the first harmonic’s TrackData entries over time
    // tracks[1] holds the second harmonic, and so on.
}

