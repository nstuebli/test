struct KalmanFilter1D {
    float x;    // state estimate (frequency)
    float P;    // estimate covariance
    float Q;    // process noise covariance
    float R;    // measurement noise covariance

    KalmanFilter1D(float init_x, float init_P,
                   float processNoise, float measNoise)
      : x(init_x), P(init_P), Q(processNoise), R(measNoise) {}

    // Incorporate a new measurement z and return smoothed estimate
    float update(float z) {
        // Predict
        P += Q;

        // Compute Kalman gain
        float K = P / (P + R);

        // Update estimate
        x += K * (z - x);

        // Update covariance
        P *= (1.0f - K);

        return x;
    }
};

