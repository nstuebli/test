#include <vector>
#include <unordered_map>
#include <cmath>       // for std::abs
#include <limits>      // for std::numeric_limits

struct Peak {
    float frequency;
    float amplitude;
    int harmonicNo;    // 0 = not harmonic, 1 = first, 2 = second, …
};

struct TrackData {
    size_t index;      // frame/time index
    float frequency;
    float amplitude;
};

// Build tracks with tie-breaking:
// 1) highest amplitude
// 2) if amplitudes equal, choose frequency closest to previous frame’s frequency
std::vector<std::vector<TrackData>> generateTracks(
    const std::vector<std::vector<Peak>>& allPeaks)
{
    // 1. Find maximum harmonic number across all frames
    int maxHarmonic = 0;
    for (auto const& frame : allPeaks) {
        for (auto const& p : frame) {
            maxHarmonic = std::max(maxHarmonic, p.harmonicNo);
        }
    }

    // 2. Prepare one track per harmonic > 0 (index 0 unused)
    std::vector<std::vector<TrackData>> tracks(maxHarmonic + 1);

    // 3. Keep last chosen frequency for each harmonic to break ties
    std::vector<float> lastFreq(maxHarmonic + 1,
                                std::numeric_limits<float>::quiet_NaN());

    // 4. Iterate frames
    for (size_t frameIdx = 0; frameIdx < allPeaks.size(); ++frameIdx) {
        // Map harmonicNo → best candidate in this frame
        std::unordered_map<int, Peak> bestInFrame;

        for (auto const& p : allPeaks[frameIdx]) {
            if (p.harmonicNo <= 0) 
                continue;

            auto it = bestInFrame.find(p.harmonicNo);
            if (it == bestInFrame.end()) {
                // first candidate for this harmonic
                bestInFrame[p.harmonicNo] = p;
            }
            else {
                Peak& currentBest = it->second;

                // Tie-breaker: higher amplitude wins
                if (p.amplitude > currentBest.amplitude) {
                    currentBest = p;
                }
                else if (p.amplitude == currentBest.amplitude) {
                    // Secondary: closer in frequency to last chosen
                    float last = lastFreq[p.harmonicNo];
                    if (!std::isnan(last)) {
                        float dNew = std::abs(p.frequency - last);
                        float dOld = std::abs(currentBest.frequency - last);
                        if (dNew < dOld) {
                            currentBest = p;
                        }
                    }
                }
            }
        }

        // 5. Commit each best peak into its track, update lastFreq
        for (auto const& kv : bestInFrame) {
            int h = kv.first;
            const Peak& chosen = kv.second;
            tracks[h].push_back({ frameIdx,
                                  chosen.frequency,
                                  chosen.amplitude });
            lastFreq[h] = chosen.frequency;
        }
    }

    // 6. Discard the 0th slot so result[0] is harmonic 1, result[1] is harmonic 2,…
    tracks.erase(tracks.begin());
    return tracks;
}

