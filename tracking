void smoothTracksWithKalman(
    std::map<int, std::vector<TrackData>>& tracks,
    float processNoise, float measNoise)
{
    for (auto& [harmonic, data] : tracks) {
        if (data.empty()) continue;
        // Initialize filter with first measurement
        KalmanFilter1D kf(data[0].frequency,
                          /* P0= */1.0f,
                          processNoise, measNoise);

        for (auto& pt : data) {
            pt.frequency = kf.update(pt.frequency);
        }
    }
}

