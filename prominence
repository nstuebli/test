#include <vector>
#include <algorithm>
#include <limits>

// Finds indices of peaks whose height and prominence exceed given thresholds
std::vector<int> findProminentPeaks(
    const std::vector<float>& spectrum,
    float heightThreshold,
    float prominenceThreshold)
{
    std::vector<int> peaks;
    int n = spectrum.size();
    if (n < 3) return peaks;  // need at least one interior point

    for (int i = 1; i < n - 1; ++i) {
        // 1. Height threshold and local maximum test
        if (spectrum[i] < heightThreshold) 
            continue;
        if (spectrum[i] <= spectrum[i - 1] || spectrum[i] <= spectrum[i + 1]) 
            continue;

        // 2. Walk left to find the lowest valley until a higher point appears
        float leftMin = spectrum[i];
        for (int j = i - 1; j >= 0; --j) {
            leftMin = std::min(leftMin, spectrum[j]);
            if (spectrum[j] > spectrum[i]) 
                break;
        }

        // 3. Walk right to find the lowest valley until a higher point appears
        float rightMin = spectrum[i];
        for (int j = i + 1; j < n; ++j) {
            rightMin = std::min(rightMin, spectrum[j]);
            if (spectrum[j] > spectrum[i]) 
                break;
        }

        // 4. Prominence calculation
        float prominence = spectrum[i] - std::max(leftMin, rightMin);
        if (prominence >= prominenceThreshold) {
            peaks.push_back(i);
        }
    }

    return peaks;
}
