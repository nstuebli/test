void  cWave::readWavData (ifstream &WavFile, unsigned int uiFileSize, eWavError* peiError)

//====================================================================================================================================
{
//  cout << "cWave::readWavData" << endl;

  uint32_t  uiFileIdx             = 12;  // First possible fmt-chunk index
  uint32_t  uiNoOfBytes           = 0;
  char      chBuffer[8];
  uint8_t*  pchSamples = nullptr;
  m_uiNoOfAmplNormSamples         = 0;
  *peiError = eWAVERROR_NO;
  std::unique_ptr<float[]>  pdAmplNormSamples;

  for (uint32_t x = uiFileIdx; x < uiFileSize - 8;)
  {
    WavFile.seekg(x);

    // read data as a block:
    WavFile.read (chBuffer, 8);
    uint32_t chunkSize = (uint32_t(uint8_t(chBuffer[7])) << 24) + (uint32_t(uint8_t(chBuffer[6])) << 16) + (uint32_t(uint8_t(chBuffer[5])) << 8) + (uint32_t(uint8_t(chBuffer[4])) << 0);
    x += 8 + chunkSize;

    if ((chBuffer[0] == 'd') &&
        (chBuffer[1] == 'a') &&
        (chBuffer[2] == 't') &&
        (chBuffer[3] == 'a'))
    {
      uiNoOfBytes = chunkSize;

      if (uiNoOfBytes > 0)
      {
        // Output is ever mono
        m_uiNoOfAmplNormSamples = uiNoOfBytes / std::ceil(m_iWidth / 8.0) / m_iChannels;

        if (m_uiNoOfAmplNormSamples > MAXAUDIOLENGTH * m_iSampleRate)
        {
          m_uiNoOfAmplNormSamples = MAXAUDIOLENGTH * m_iSampleRate;

          *peiError = eWAVERROR_TOBIG;
        }

        // Create buffer for samples
        // 5760000 double values for 120s @48kHz (probably 8 byte per double -> 46,08 MByte)
        // 28800000 double values for 600s @48kHz (-> 230,4 MByte)
        pdAmplNormSamples.reset();
        pdAmplNormSamples = std::make_unique<float[]>(m_uiNoOfAmplNormSamples);
        for (uint64_t i = 0; i < m_uiNoOfAmplNormSamples; i++)
          pdAmplNormSamples[i] = 0.0;
      }
    }
  }

  pchSamples = new uint8_t[std::ceil(m_iWidth / 8.0) * m_iChannels];
  // Convert to mono and normalize to 1.0 (soundcard range)
  if ((m_eFormat == eWAVFORMAT_LINEAR_PCM))
  {
    for (uint64_t x = 0; x < m_uiNoOfAmplNormSamples; x++)
    {
      WavFile.read(reinterpret_cast<char*>(pchSamples), std::ceil(m_iWidth / 8.0) * m_iChannels);
      pdAmplNormSamples[x] = getMonoSamplePcm(pchSamples, m_iWidth, m_iChannels);
    }
  }
  else if ((m_eFormat == eWAVFORMAT_IEEE_FLOAT) && (m_iWidth == 32))
  {
    for (uint64_t x = 0; x < m_uiNoOfAmplNormSamples; x++)
    {
      WavFile.read(reinterpret_cast<char*>(pchSamples), std::ceil(m_iWidth / 8.0) * m_iChannels);
      pdAmplNormSamples[x] = getMonoSampleIeee<float>(pchSamples, m_iChannels);
    }
  }
  else if ((m_eFormat == eWAVFORMAT_IEEE_FLOAT) && (m_iWidth == 64))
  {
    for (uint64_t x = 0; x < m_uiNoOfAmplNormSamples; x++)
    {
      WavFile.read(reinterpret_cast<char*>(pchSamples), std::ceil(m_iWidth / 8.0) * m_iChannels);
      pdAmplNormSamples[x] = getMonoSampleIeee<double>(pchSamples, m_iChannels);
    }
  }
  delete[] pchSamples;
  pchSamples = nullptr;

  // Convert to internal samplerate
  m_uiNoOfFreqNormSamples = uint64_t((double)m_uiNoOfAmplNormSamples / m_dTimeIncr);

  // Create buffer for samples
  m_pdFreqNormSamples = std::make_unique<float[]>(m_uiNoOfFreqNormSamples);
  for (uint64_t i = 0; i < m_uiNoOfFreqNormSamples; i++)
    m_pdFreqNormSamples[i] = 0.0;

  //CZRAW Calculate size of the raw data set which is processes in cSonarFft while FRAMESIZE=1024 audio signals are played.
  m_fftFrameSize = dataxsdstruct::FRAMESIZE * m_dTimeIncr; //CZRAW

  double  dAmplDiff;
  double  dTimeDiff;
  double  dOffset;
  double  dSampleIdx = 0.0;

  int count = 0;
  for (uint64_t x = 0; x < m_uiNoOfFreqNormSamples; ++x)
  {
    dAmplDiff = pdAmplNormSamples[uint64_t(dSampleIdx) + 1] - pdAmplNormSamples[uint64_t(dSampleIdx)];
    dTimeDiff = dSampleIdx - uint64_t(dSampleIdx);
    dOffset   = dAmplDiff * dTimeDiff;

    m_pdFreqNormSamples[x] = pdAmplNormSamples[uint64_t(dSampleIdx)] + dOffset;

    dSampleIdx += m_dTimeIncr;
    count++;
  }
}





template <typename T>
double getMonoSampleIeee (uint8_t const* samples, uint32_t const channels)

//====================================================================================================================================
{
  T const* actual_samples = reinterpret_cast<T const*>(samples);
  double sample = 0;
  for (uint32_t x = 0; x < channels; ++x)
  {
    sample += actual_samples[x];
  }
  return (sample / double(channels));
}
