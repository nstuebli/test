void CPAFinder::createTracks()
{
    PeakFinder peakFinder(m_Spectrogram);
    Peaks meanPeaks = peakFinder.getPeaks(TimeRange{ 0, m_Spectrogram.m_Spectrogram.size() }, 3.0f);
    Spectrum spectrumBuffer;
    std::vector<float> kernel = Vectormath::generateGaussianKernel(3.0f);

    // 1. Find highest harmonic number

    for (size_t i = 0u; i < meanPeaks.m_Peaks.size(); ++i)
    {
        meanPeaks.m_Peaks[i].PeakHarmonicNo = i + 1;
    }

    int maxHarmonic = 0;
    for (const Peak& peak : meanPeaks.m_Peaks)
    {
        if (peak.PeakHarmonicNo > maxHarmonic)
        {
            maxHarmonic = peak.PeakHarmonicNo;
        }
    }

    // 2. Prepare one track per harmonic > 0; ignore index 0
    m_TrackList.resize(maxHarmonic);

    // TODOOOOO :: remove unecessary freqs (> cutoff oder sogar noch niedriger?)


    // 3. Fill tracks
    for (size_t i = 0; i < m_PeaksOverTime.size(); ++i)
    {
        spectrumBuffer = m_Spectrogram.m_Spectrogram[i];
        Vectormath::convolveSymmetric(spectrumBuffer.m_Level, kernel);
        m_PeaksOverTime[i] = spectrumBuffer.findPeaks(3.0f, m_Spectrogram.m_Frequency);

        for (const Peak& peak : meanPeaks.m_Peaks)
        {
            for (size_t j = 0u; j < m_PeaksOverTime[i].m_Peaks.size(); ++j)
            {
                if (std::abs(m_PeaksOverTime[i].m_Peaks[j].PeakFrequency - peak.PeakFrequency) < 0.075f)
                {
                    m_PeaksOverTime[i].m_Peaks[j].PeakHarmonicNo = peak.PeakHarmonicNo;
                    break;
                }
            }
        }

        for (const Peak& peak : m_PeaksOverTime[i].m_Peaks)
        {
            if (peak.PeakHarmonicNo > 0)
            {
                m_TrackList[peak.PeakHarmonicNo - 1].push_back(
                    TrackData{ i, peak.PeakFrequency, peak.PeakLevel}
                );
            }
        }
    }







import numpy as np
from dataclasses import dataclass
from typing import List, Callable

@dataclass
class Peak:
    PeakFrequency: float
    PeakLevel: float
    PeakHarmonicNo: int = 0

@dataclass
class TrackData:
    time_idx: int
    frequency: float
    level: float

def build_tracks(
    spectrogram: List[np.ndarray],
    mean_peaks: List[Peak],
    find_peaks_fn: Callable[[np.ndarray], List[Peak]],
    freq_tolerance: float = 0.075
) -> List[List[TrackData]]:
    """
    Port of the C++ logic into Python.  
    - spectrogram: list of 1D numpy arrays (one per time‐bin)  
    - mean_peaks:  list of Peaks from the averaged spectrum  
    - find_peaks_fn: function that returns List[Peak] for one frame  
    - freq_tolerance: Δf threshold for matching peaks  
    """

    # 1. Number the master peaks 1..N
    for idx, peak in enumerate(mean_peaks):
        peak.PeakHarmonicNo = idx + 1

    # 2. How many harmonics do we have?
    max_harmonic = max(p.PeakHarmonicNo for p in mean_peaks)

    # 3. Prepare an empty track for each harmonic
    track_list: List[List[TrackData]] = [[] for _ in range(max_harmonic)]

    # 4. Go through each time‐bin, detect & assign
    for t_idx, frame in enumerate(spectrogram):
        frame_peaks = find_peaks_fn(frame)

        # assign each detected peak to the nearest master peak (if within tolerance)
        for m in mean_peaks:
            for p in frame_peaks:
                if abs(p.PeakFrequency - m.PeakFrequency) < freq_tolerance:
                    p.PeakHarmonicNo = m.PeakHarmonicNo
                    break

        # fill the tracks
        for p in frame_peaks:
            if p.PeakHarmonicNo > 0:
                track_list[p.PeakHarmonicNo - 1].append(
                    TrackData(time_idx=t_idx, frequency=p.PeakFrequency, level=p.PeakLevel)
                )

    return track_list
