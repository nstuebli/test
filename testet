SCORE_LOG_DEBUG( mTMLogger, std::setfill( ' ' ) );
	SCORE_LOG_DEBUG( mTMLogger, " " );
	SCORE_LOG_DEBUG( mTMLogger, std::setw( 4 ) << frData->Track.trackId << "      | " );

	if ( frData->Track.trackNumber.trackNumber == 0 )	// own ship
	{
		// Type
		SCORE_LOG_DEBUG( mTMLogger, "     OS | " );
		// STD STT designation
		SCORE_LOG_DEBUG( mTMLogger, "    | " );
		// STD STT Id
		SCORE_LOG_DEBUG( mTMLogger, "     | " );
		// STD STT Bearing
		SCORE_LOG_DEBUG( mTMLogger, "      | " );
		// AFE STT designation
		SCORE_LOG_DEBUG( mTMLogger, "    | " );
		// AFE STT Id
		SCORE_LOG_DEBUG( mTMLogger, "     | " );
		// AFE STT Bearing
		SCORE_LOG_DEBUG( mTMLogger, "      | " );
		// CMS
		SCORE_LOG_DEBUG( mTMLogger, "       | " );
		// CMS Id
//		SCORE_LOG_DEBUG( mTMLogger, "     | " );  - not used
		// TMA
		SCORE_LOG_DEBUG( mTMLogger, "    | " );
		// TMA Id
		SCORE_LOG_DEBUG( mTMLogger, "     | " );


		if ( frData->Track.trackAttrCtrl.trackPositionData.brn.valid )
		{
			if ( frData->Track.trackAttrCtrl.trackPositionData.brn.value >= 0.0 )
			{
				SCORE_LOG_DEBUG( mTMLogger, std::fixed << std::setw( 5 ) << std::setprecision( 1 ) << frData->Track.trackAttrCtrl.trackPositionData.brn.value * 180.0/M_PI << " | " );
			}
			else
			{
				SCORE_LOG_DEBUG( mTMLogger, std::fixed << std::setw( 5 ) << std::setprecision( 1 ) << frData->Track.trackAttrCtrl.trackPositionData.brn.value * 180.0/M_PI + 360.0 << " | " );
			}
		}
		else
		{
			SCORE_LOG_DEBUG( mTMLogger, "     | " );
		}
		if ( frData->Track.trackAttrCtrl.trackPositionData.rng.valid )
		{
			SCORE_LOG_DEBUG( mTMLogger, std::fixed << std::setw( 8 ) << std::setprecision( 1 ) << frData->Track.trackAttrCtrl.trackPositionData.rng.value / 1000.0 << " | " );
		}
		else
		{
			SCORE_LOG_DEBUG( mTMLogger, "         | " );
		}
		if ( frData->Track.trackAttrCtrl.trackPositionData.course.valid )
		{
			if ( frData->Track.trackAttrCtrl.trackPositionData.course.value >= 0.0 )
			{
				SCORE_LOG_DEBUG( mTMLogger, std::fixed << std::setw( 5 ) << std::setprecision( 1 ) << frData->Track.trackAttrCtrl.trackPositionData.course.value * 180.0/M_PI << " | " );
			}
			else
			{
				SCORE_LOG_DEBUG( mTMLogger, std::fixed << std::setw( 5 ) << std::setprecision( 1 ) << frData->Track.trackAttrCtrl.trackPositionData.course.value * 180.0/M_PI + 360.0 << " | " );
			}
		}
		else
		{
			SCORE_LOG_DEBUG( mTMLogger, "      | " );
		}
		if ( frData->Track.trackAttrCtrl.trackPositionData.speed.valid )
		{
			SCORE_LOG_DEBUG( mTMLogger, std::fixed << std::setw( 5 ) << std::setprecision( 1 ) << frData->Track.trackAttrCtrl.trackPositionData.speed.value << " | " );
		}
		else
		{
			SCORE_LOG_DEBUG( mTMLogger, "      | " );
		}

		// main sensor
		SCORE_LOG_DEBUG( mTMLogger,  "              | " );
	}
