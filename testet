void FFT::fft(std::vector<std::complex<float>>& input)
{
    const size_t n = input.size();
    if (n <= 1) return;

    size_t j = 0;

    for (size_t i = 1; i < n; i++)
    {
        size_t bit = n >> 1;
        while (j & bit)
        {
            j ^= bit;
            bit >>= 1;
        }
        j ^= bit;

        if (i < j)
        {
            std::swap(input[i], input[j]);
        }
    }

    for (size_t len = 2; len <= n; len <<= 1)
    {
        const float ang = static_cast<float>(-2.0f * M_PI / len);
        std::complex<float> wlen(std::cos(ang), std::sin(ang));

        for (size_t i = 0; i < n; i += len)
        {
            std::complex<float> w(1);
            for (size_t j = 0; j < len / 2; ++j)
            {
                std::complex<float> u = input[i + j];
                std::complex<float> v = input[i + j + len / 2] * w;
                input[i + j] = u + v;
                input[i + j + len / 2] = u - v;
                w *= wlen;
            }
        }
    }
}
